# Safepay Pakistan Sandbox & Live Configuration
# Official docs: https://docs.getsafepay.com

# 1. Sign up for a sandbox account at: https://sandbox.getsafepay.com
# 2. Retrieve your sandbox API key and Secret key from the Developer / API Settings page.
# 3. Add them below (do not commit actual secrets to git).

# SAFEPAY_API_KEY=sec_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# SAFEPAY_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SAFEPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Set gateway mode: 'SANDBOX' or 'SIMULATOR'.
# When left unset or empty, the app defaults to Local Payment Simulator with Safepay protocol emulation.
PAYMENT_GATEWAY_MODE=SIMULATOR
