datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Doctor {
  id           Int       @id @default(autoincrement())
  name         String
  specialty    String
  availability String    // "On Duty", "On Call", "Off Duty", "In Consultation"
  contact      String
  email        String    @unique
  experience   String
  avatarUrl    String
  patients     Patient[]
  appointments Appointment[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Patient {
  id             Int      @id @default(autoincrement())
  name           String
  age            Int
  gender         String
  contact        String
  condition      String
  status         String   // "Admitted", "Outpatient", "Recovering", "Critical", "Discharged"
  doctorId       Int?
  doctor         Doctor?  @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  assignedDoctor String?  // cached or fallback doctor name
  roomNumber     String?
  photoUrl       String?
  admittedDate   DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model InventoryItem {
  id           Int      @id @default(autoincrement())
  name         String
  category     String   // "Medicine", "Supplies", "Consumables", "Equipment"
  stock        Int
  unitPrice    Float
  minThreshold Int      @default(20)
  status       String   // "In Stock", "Low Stock", "Out of Stock"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Appointment {
  id               Int      @id @default(autoincrement())
  bookingCode      String   @unique
  patientName      String
  mobileNumber     String
  email            String
  consultationType String   // "Online Video Call" or "Physical at Hospital Inspection"
  department       String
  doctorId         Int?
  doctor           Doctor?  @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  doctorName       String
  appointmentDate  String
  timeSlot         String
  slotKey          String
  otpCode          String
  paymentStatus    String   @default("Paid (Advance)")
  paymentMethod    String   @default("Credit/Debit Card")
  transactionId    String
  consultationFee  Float    @default(50.0)
  photoUrl         String?
  status           String   @default("Confirmed")
  smsSent          Boolean  @default(true)
  emailSent        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

